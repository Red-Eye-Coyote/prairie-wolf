      "$value": "{fontFamily.redHatDisplay}"
    },
    "body": {
      "$type": "fontFamilies",
      "$value": "{fontFamily.inter}"
    }
  },
  "fontWeight": {
    "heading": {
      "$type": "fontWeights",
      "$value": "{fontWeight.inter.bold}"
    },
    "body": {
      "$type": "fontWeights",
      "$value": "{fontWeight.redHatText.regular}"
    }
  },
  "nRatio": {
