{
  "res_fontSize": {
    "base": {
      "0": {
        "$type": "fontSizes",
        "$value": "{res_fontSize.base.1} / {res_fontSize.base.scale}"
      },
      "1": {
        "$type": "fontSizes",
        "$value": "{res_fontSize.base.root}"
      },
      "2": {
        "$type": "fontSizes",
        "$value": "{res_fontSize.base.1} * {res_fontSize.base.scale}"
      },
      "3": {
        "$type": "fontSizes",
        "$value": "{res_fontSize.base.2} * {res_fontSize.base.scale}"
      },
      "4": {
        "$type": "fontSizes",
        "$value": "{res_fontSize.base.3} * {res_fontSize.base.scale}"
      },
      "5": {
        "$type": "fontSizes",
        "$value": "{res_fontSize.base.4} * {res_fontSize.base.scale}"
      },
      "6": {
        "$type": "fontSizes",
        "$value": "{res_fontSize.base.5} * {res_fontSize.base.scale}"
      },
      "7": {
        "$type": "fontSizes",
        "$value": "{res_fontSize.base.6} * {res_fontSize.base.scale}"
      },
      "8": {
        "$type": "fontSizes",
        "$value": "{res_fontSize.base.7} * {res_fontSize.base.scale}"
      },
      "root": {
        "$type": "fontSizes",
        "$value": "16"
      },
      "scale": {
        "$type": "fontSizes",
        "$value": "1.2"
      }
    }
  },
  "lineHeights": {
    "multiplier-body": {
      "$type": "lineHeights",
      "$value": "1.6"
    },
    "multiplier-heading": {
      "$type": "lineHeights",
      "$value": "1.2"
    },
    "body": {
      "0": {
        "$type": "lineHeights",
        "$value": "round({res_fontSize.base.0} * {lineHeights.multiplier-body} / 4) * 4"
      },
      "1": {
        "$type": "lineHeights",
        "$value": "round({res_fontSize.base.1} * {lineHeights.multiplier-body} / 4) * 4"
      },
      "2": {
        "$type": "lineHeights",
        "$value": "round({res_fontSize.base.2} * {lineHeights.multiplier-body} / 4) * 4"
      }
    },
    "heading": {
      "0": {
        "$type": "lineHeights",
        "$value": "round({res_fontSize.base.2} * {lineHeights.multiplier-heading} / 4) * 4"
      },
      "1": {
        "$type": "lineHeights",
        "$value": "round({res_fontSize.base.3} * {lineHeights.multiplier-heading} / 4) * 4"
      },
      "2": {
        "$type": "lineHeights",
        "$value": "round({res_fontSize.base.4} * {lineHeights.multiplier-heading} / 4) * 4"
      },
      "3": {
        "$type": "lineHeights",
        "$value": "round({res_fontSize.base.5} * {lineHeights.multiplier-heading} / 4) * 4"
      },
      "4": {
        "$type": "lineHeights",
        "$value": "round({res_fontSize.base.6} * {lineHeights.multiplier-heading} / 4) * 4"
      },
      "5": {
        "$type": "lineHeights",
        "$value": "round({res_fontSize.base.7} * {lineHeights.multiplier-heading} / 4) * 4"
      },
      "6": {
        "$type": "lineHeights",
        "$value": "round({res_fontSize.base.8} * {lineHeights.multiplier-heading} / 4) * 4"
      }
    }
  }
}