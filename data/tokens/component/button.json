  "button-borders": {
    "default": {
      "$type": "border",
      "$value": {
        "color": "none",
        "width": "{borderWidth.sm}",
        "style": "solid"
      }
    },
    "outlined": {
      "enabled": {
        "$type": "border",
        "$value": {
          "color": "{theme-colors.sys.outline}",
          "width": "{borderWidth.sm}",
          "style": "solid"
        }
      },
      "hovered": {
        "$type": "border",
        "$value": {
          "color": "{theme-colors.sys.outline}",
          "width": "{borderWidth.sm}",
          "style": "solid"
        }
      },
      "pressed": {
        "$type": "border",
        "$value": {
          "color": "{theme-colors.sys.outline}",
          "width": "{borderWidth.sm}",
          "style": "solid"
        }
      },
      "focused": {
        "$type": "border",
        "$value": {
          "color": "{theme-colors.sys.primary}",
          "width": "{borderWidth.sm}",
          "style": "solid"
        }
      },
      "disabled": {
        "$type": "border",
        "$value": {
          "color": "{theme-colors.state-layers.on-surface.12}",
          "width": "{borderWidth.sm}",
          "style": "solid"
        }
      }
    }
  },
  "button-dimensions": {
    "state-layer": {
      "padding-top": {
        "$type": "dimension",
        "$value": "{spacing.absolute.10}"
      },
      "padding-bottom": {
        "$type": "dimension",
        "$value": "{spacing.absolute.10}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{component.gap.absolute.md}"
      },
      "padding-left": {
        "sm": {
          "$type": "dimension",
          "$value": "{spacing.absolute.12}"
        },
        "md": {
          "$type": "dimension",
          "$value": "{spacing.absolute.16}"
        },
        "lg": {
          "$type": "dimension",
          "$value": "{spacing.absolute.24}"
        }
      },
      "padding-right": {
        "sm": {
          "$type": "dimension",
          "$value": "{spacing.absolute.12}"
        },
        "md": {
          "$type": "dimension",
          "$value": "{spacing.absolute.16}"
        },
        "lg": {
          "$type": "dimension",
          "$value": "{spacing.absolute.24}"
        }
      }
    }
  },
  "button-radii": {
    "default": {
      "$type": "borderRadius",
      "$value": "{borderRadius._ref.100}"
    }
  },
  "button": {
    "typography": {
      "label": {
        "$type": "typography",
        "$value": "{base.label.large}"
      }
    }
  }
