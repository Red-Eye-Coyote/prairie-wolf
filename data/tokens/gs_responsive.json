{
  "res_fontSize": {
    "root": {
      "$type": "fontSizes",
      "$value": "16"
    },
    "scale": {
      "$type": "fontSizes",
      "$value": "1.2"
    },
    "body": {
      "sm": {
        "$type": "fontSizes",
        "$value": "floor({res_fontSize.body.md} / {res_fontSize.scale} / 4) * 4"
      },
      "md": {
        "$type": "fontSizes",
        "$value": "{res_fontSize.root}"
      },
      "lg": {
        "$type": "fontSizes",
        "$value": "ceil({res_fontSize.body.md} * {res_fontSize.scale} / 4) * 4"
      }
    },
    "heading": {
      "h6": {
        "$type": "fontSizes",
        "$value": "ceil({res_fontSize.root} * {res_fontSize.scale} / 4) * 4"
      },
      "h5": {
        "$type": "fontSizes",
        "$value": "ceil({res_fontSize.heading.h6} * {res_fontSize.scale} / 4) * 4"
      },
      "h4": {
        "$type": "fontSizes",
        "$value": "ceil({res_fontSize.heading.h5} * {res_fontSize.scale} / 4) * 4"
      },
      "h3": {
        "$type": "fontSizes",
        "$value": "ceil({res_fontSize.heading.h4} * {res_fontSize.scale} / 4) * 4"
      },
      "h2": {
        "$type": "fontSizes",
        "$value": "ceil({res_fontSize.heading.h3} * {res_fontSize.scale} / 4) * 4"
      },
      "h1": {
        "$type": "fontSizes",
        "$value": "ceil({res_fontSize.heading.h2} * {res_fontSize.scale} / 4) * 4"
      }
    }
  },
  "res_lineHeights": {
    "multiplier-body": {
      "$type": "lineHeights",
      "$value": "1.6"
    },
    "multiplier-heading": {
      "$type": "lineHeights",
      "$value": "1.2"
    },
    "body": {
      "sm": {
        "$type": "lineHeights",
        "$value": "ceil({res_fontSize.body.sm} * {res_lineHeights.multiplier-body} / 4) * 4"
      },
      "md": {
        "$type": "lineHeights",
        "$value": "ceil({res_fontSize.body.md} * {res_lineHeights.multiplier-body} / 4) * 4"
      },
      "lg": {
        "$type": "lineHeights",
        "$value": "ceil({res_fontSize.body.lg} * {res_lineHeights.multiplier-body} / 4) * 4"
      }
    },
    "heading": {
      "h6": {
        "$type": "lineHeights",
        "$value": "ceil({res_fontSize.heading.h6} * {res_lineHeights.multiplier-heading} / 4) * 4"
      },
      "h5": {
        "$type": "lineHeights",
        "$value": "ceil({res_fontSize.heading.h5} * {res_lineHeights.multiplier-heading} / 4) * 4"
      },
      "h4": {
        "$type": "lineHeights",
        "$value": "ceil({res_fontSize.heading.h4} * {res_lineHeights.multiplier-heading} / 4) * 4"
      },
      "h3": {
        "$type": "lineHeights",
        "$value": "ceil({res_fontSize.heading.h3} * {res_lineHeights.multiplier-heading} / 4) * 4"
      },
      "h2": {
        "$type": "lineHeights",
        "$value": "ceil({res_fontSize.heading.h2} * {res_lineHeights.multiplier-heading} / 4) * 4"
      },
      "h1": {
        "$type": "lineHeights",
        "$value": "ceil({res_fontSize.heading.h1} * {res_lineHeights.multiplier-heading} / 4) * 4"
      }
    }
  },
  "res_paragraphSpacing": {
    "body": {
      "sm": {
        "$type": "paragraphSpacing",
