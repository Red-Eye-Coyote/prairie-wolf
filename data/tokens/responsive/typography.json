{
  "fontSize": {
    "root": {
      "$type": "fontSizes",
      "$value": "16"
    },
    "scale": {
      "$type": "fontSizes",
      "$value": "1.2"
    },
    "body": {
      "sm": {
        "$type": "fontSizes",
        "$value": "floor({fontSize.body.md} / {fontSize.scale} / 4) * 4"
      },
      "md": {
        "$type": "fontSizes",
        "$value": "{fontSize.root}"
      },
      "lg": {
        "$type": "fontSizes",
        "$value": "ceil({fontSize.body.md} * {fontSize.scale} / 4) * 4"
      }
    },
    "heading": {
      "h6": {
        "$type": "fontSizes",
        "$value": "ceil({fontSize.root} * {fontSize.scale} / 4) * 4"
      },
      "h5": {
        "$type": "fontSizes",
        "$value": "ceil({fontSize.heading.h6} * {fontSize.scale} / 4) * 4"
      },
      "h4": {
        "$type": "fontSizes",
        "$value": "ceil({fontSize.heading.h5} * {fontSize.scale} / 4) * 4"
      },
      "h3": {
        "$type": "fontSizes",
        "$value": "ceil({fontSize.heading.h4} * {fontSize.scale} / 4) * 4"
      },
      "h2": {
        "$type": "fontSizes",
        "$value": "ceil({fontSize.heading.h3} * {fontSize.scale} / 4) * 4"
      },
      "h1": {
        "$type": "fontSizes",
        "$value": "ceil({fontSize.heading.h2} * {fontSize.scale} / 4) * 4"
      }
    }
  },
  "lineHeight": {
    "multiplier-body": {
      "$type": "lineHeights",
      "$value": "1.6"
    },
    "multiplier-heading": {
      "$type": "lineHeights",
      "$value": "1.2"
    },
    "body": {
      "sm": {
        "$type": "lineHeights",
        "$value": "ceil({fontSize.body.sm} * {lineHeight.multiplier-body} / 4) * 4"
      },
      "md": {
        "$type": "lineHeights",
        "$value": "ceil({fontSize.body.md} * {lineHeight.multiplier-body} / 4) * 4"
      },
      "lg": {
        "$type": "lineHeights",
        "$value": "ceil({fontSize.body.lg} * {lineHeight.multiplier-body} / 4) * 4"
      }
    },
    "heading": {
      "h6": {
        "$type": "lineHeights",
        "$value": "ceil({fontSize.heading.h6} * {lineHeight.multiplier-heading} / 4) * 4"
      },
      "h5": {
        "$type": "lineHeights",
        "$value": "ceil({fontSize.heading.h5} * {lineHeight.multiplier-heading} / 4) * 4"
      },
      "h4": {
        "$type": "lineHeights",
        "$value": "ceil({fontSize.heading.h4} * {lineHeight.multiplier-heading} / 4) * 4"
      },
      "h3": {
        "$type": "lineHeights",
        "$value": "ceil({fontSize.heading.h3} * {lineHeight.multiplier-heading} / 4) * 4"
      },
      "h2": {
        "$type": "lineHeights",
        "$value": "ceil({fontSize.heading.h2} * {lineHeight.multiplier-heading} / 4) * 4"
      },
      "h1": {
        "$type": "lineHeights",
        "$value": "ceil({fontSize.heading.h1} * {lineHeight.multiplier-heading} / 4) * 4"
      }
    }
  },
  "paragraphSpacing": {
    "body": {
      "sm": {
        "$type": "paragraphSpacing",
        "$value": "20"
      },
      "md": {
        "$type": "paragraphSpacing",
        "$value": "28"
      },
      "lg": {
        "$type": "paragraphSpacing",
        "$value": "32"
      }
    },
    "heading": {
      "h6": {
        "$type": "paragraphSpacing",
        "$value": "24"
      },
      "h5": {
        "$type": "paragraphSpacing",
        "$value": "28"
      },
      "h4": {
        "$type": "paragraphSpacing",
        "$value": "32"
      },
      "h3": {
        "$type": "paragraphSpacing",
        "$value": "36"
      },
      "h2": {
        "$type": "paragraphSpacing",
        "$value": "40"
      },
      "h1": {
        "$type": "paragraphSpacing",
        "$value": "48"
      }
    }
  },
  "heading": {
    "h6": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.heading}",
        "fontWeight": "{fontWeight.heading}",
        "lineHeight": "{lineHeight.heading.h6}",
        "fontSize": "{fontSize.heading.h6}",
        "paragraphSpacing": "{paragraphSpacing.heading.h6}"
      }
    },
    "h5": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.heading}",
        "fontWeight": "{fontWeight.heading}",
        "lineHeight": "{lineHeight.heading.h5}",
        "fontSize": "{fontSize.heading.h5}",
        "paragraphSpacing": "{paragraphSpacing.heading.h5}"
      }
    },
    "h4": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.heading}",
        "fontWeight": "{fontWeight.heading}",
        "lineHeight": "{lineHeight.heading.h4}",
        "fontSize": "{fontSize.heading.h4}",
        "paragraphSpacing": "{paragraphSpacing.heading.h4}"
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.heading}",
        "fontWeight": "{fontWeight.heading}",
        "lineHeight": "{lineHeight.heading.h3}",
        "fontSize": "{fontSize.heading.h3}",
        "paragraphSpacing": "{paragraphSpacing.heading.h3}"
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.heading}",
        "fontWeight": "{fontWeight.heading}",
        "lineHeight": "{lineHeight.heading.h2}",
        "fontSize": "{fontSize.heading.h2}",
        "paragraphSpacing": "{paragraphSpacing.heading.h2}"
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.heading}",
        "fontWeight": "{fontWeight.heading}",
        "lineHeight": "{lineHeight.heading.h1}",
        "fontSize": "{fontSize.heading.h1}",
        "paragraphSpacing": "{paragraphSpacing.heading.h1}"
      }
    }
  },
  "body": {
    "sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.inter}",
        "fontWeight": "{fontWeight.redHatText.regular}",
        "lineHeight": "{lineHeight.body.sm}",
        "fontSize": "{fontSize.body.sm}",
        "paragraphSpacing": "{paragraphSpacing.body.sm}"
      }
    },
    "md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.inter}",
        "fontWeight": "{fontWeight.redHatText.regular}",
        "lineHeight": "{lineHeight.body.md}",
        "fontSize": "{fontSize.body.md}",
        "paragraphSpacing": "{paragraphSpacing.body.md}"
      }
    },
    "lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.inter}",
        "fontWeight": "{fontWeight.redHatText.regular}",
        "lineHeight": "{lineHeight.body.lg}",
        "fontSize": "{fontSize.body.lg}",
        "paragraphSpacing": "{paragraphSpacing.body.lg}"
      }
    }
  }
}