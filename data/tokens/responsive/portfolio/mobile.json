{
  "fontSize": {
    "root": {
      "$type": "fontSizes",
      "$value": "16"
    },
    "body": {
      "sm": {
        "$type": "fontSizes",
        "$value": "round( {fontSize.root} * pow({typescale.default} , -1) / 4) * 4"
      },
      "md": {
        "$type": "fontSizes",
        "$value": "{fontSize.root}"
      },
      "lg": {
        "$type": "fontSizes",
        "$value": "round( {fontSize.root} * pow({typescale.default} , 1) / 4) * 4"
      }
    },
    "heading": {
      "h6": {
        "$type": "fontSizes",
        "$value": "round( {fontSize.root} * pow({typescale.default} , 1) / 4) * 4"
      },
      "h5": {
        "$type": "fontSizes",
        "$value": "round( {fontSize.root} * pow({typescale.default} , 2) / 4) * 4"
      },
      "h4": {
        "$type": "fontSizes",
        "$value": "round( {fontSize.root} * pow({typescale.default} , 3) / 4) * 4"
      },
      "h3": {
        "$type": "fontSizes",
        "$value": "round( {fontSize.root} * pow({typescale.default} , 4) / 4) * 4"
      },
      "h2": {
        "$type": "fontSizes",
        "$value": "round( {fontSize.root} * pow({typescale.default} , 5) / 4) * 4"
      },
      "h1": {
        "$type": "fontSizes",
        "$value": "round( {fontSize.root} * pow({typescale.default} , 6) / 4) * 4"
      }
    }
  },
  "lineHeight": {
    "body": {
      "sm": {
        "$type": "lineHeights",
        "$value": "round({fontSize.body.sm} * {multipliers.lineHeight-body} / 4) * 4"
      },
      "md": {
        "$type": "lineHeights",
        "$value": "round({fontSize.body.md} * {multipliers.lineHeight-body} / 4) * 4"
      },
      "lg": {
        "$type": "lineHeights",
        "$value": "round({fontSize.body.lg} * {multipliers.lineHeight-body} / 4) * 4"
      }
    },
    "heading": {
      "h6": {
        "$type": "lineHeights",
        "$value": "round({fontSize.heading.h6} * {multipliers.lineHeight-heading} / 4) * 4"
      },
      "h5": {
        "$type": "lineHeights",
        "$value": "round({fontSize.heading.h5} * {multipliers.lineHeight-heading} / 4) * 4"
      },
      "h4": {
        "$type": "lineHeights",
        "$value": "round({fontSize.heading.h4} * {multipliers.lineHeight-heading} / 4) * 4"
      },
      "h3": {
        "$type": "lineHeights",
        "$value": "round({fontSize.heading.h3} * {multipliers.lineHeight-heading} / 4) * 4"
      },
      "h2": {
        "$type": "lineHeights",
        "$value": "round({fontSize.heading.h2} * {multipliers.lineHeight-heading} / 4) * 4"
      },
      "h1": {
        "$type": "lineHeights",
        "$value": "round({fontSize.heading.h1} * {multipliers.lineHeight-heading} / 4) * 4"
      }
    }
  },
  "paragraphSpacing": {
    "body": {
      "sm": {
        "$type": "paragraphSpacing",
        "$value": "{lineHeight.body.sm}"
      },
      "md": {
        "$type": "paragraphSpacing",
        "$value": "{lineHeight.body.md}"
      },
      "lg": {
        "$type": "paragraphSpacing",
        "$value": "{lineHeight.body.lg}"
      }
    },
    "heading": {
      "h6": {
        "$type": "paragraphSpacing",
        "$value": "{lineHeight.heading.h6}"
      },
      "h5": {
        "$type": "paragraphSpacing",
        "$value": "{lineHeight.heading.h5}"
      },
      "h4": {
        "$type": "paragraphSpacing",
        "$value": "{lineHeight.heading.h4}"
      },
      "h3": {
        "$type": "paragraphSpacing",
        "$value": "{lineHeight.heading.h3}"
      },
      "h2": {
        "$type": "paragraphSpacing",
        "$value": "{lineHeight.heading.h2}"
      },
      "h1": {
        "$type": "paragraphSpacing",
        "$value": "{lineHeight.heading.h1}"
      }
    }
  },
  "typescale": {
    "default": {
      "$type": "other",
      "$value": "{typescale.minorThird}"
    }
  }
}